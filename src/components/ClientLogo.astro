---
import { getImage } from "astro:assets";
import type { ClientProfile } from "../lib/clients";

type Props = {
  profile: ClientProfile;
  /** Rendered height in CSS pixels – used to request a matching image size. */
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
};

const { profile, height, class: className, loading = "lazy" } = Astro.props;
const logo = profile.logo;
const width = logo ? Math.round((logo.width / logo.height) * height) : 0;
const densities = [1, 2, 3].filter((density) => logo && height * density <= logo.height);
const rendition = logo
  ? await getImage({ src: logo, height, densities: densities.length > 0 ? densities : [1], format: "webp" })
  : undefined;
// Square root of the aspect ratio: sized as `unit × --logo-scale` wide, wide and round logos carry similar weight.
const scale = logo ? Math.sqrt(logo.width / logo.height).toFixed(3) : undefined;
---

{
  rendition && (
    <img
      class={className}
      src={rendition.src}
      srcset={rendition.srcSet.attribute}
      width={width}
      height={height}
      style={`--logo-scale: ${scale}`}
      alt=""
      loading={loading}
      decoding="async"
    />
  )
}
