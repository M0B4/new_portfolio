---
// Sticker wall on a black band: only the client logos, each sticker cut to its logo and linking to its work.
import ClientLogo from "./ClientLogo.astro";
import type { TourStop } from "../lib/content";
import { clientPath, t, type Lang } from "../lib/i18n";

type Props = {
  stops: TourStop[];
  lang: Lang;
};

const { stops, lang } = Astro.props;
const ui = t(lang);
---

<ul class="client-wall" aria-label={ui.clientsListLabel}>
  {
    stops.map((stop) => (
      <li>
        <a class="client-tile" href={clientPath(lang, stop.profile.slug)}>
          {stop.profile.logo ? (
            <ClientLogo class="client-tile-logo" profile={stop.profile} height={180} />
          ) : (
            <span class="client-tile-text" aria-hidden="true">
              {stop.profile.label}
            </span>
          )}
          <span class="sr-only">{ui.viewWorkFor(stop.profile.label)}</span>
        </a>
      </li>
    ))
  }
</ul>
