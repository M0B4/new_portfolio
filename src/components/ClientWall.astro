---
// Sticker wall on a black band: only the client logos, each a worn sticker cut to its logo and linking to its work.
import ClientLogo from "./ClientLogo.astro";
import type { ClientGroup } from "../lib/clients";
import { clientPath, t, type Lang } from "../lib/i18n";

type Props = {
  stops: ClientGroup[];
  lang: Lang;
};

const { stops, lang } = Astro.props;
const ui = t(lang);
// The sticker is cut to the logo: a long strip for wide logos, a cut-corner block for round ones, a label otherwise.
const shapeOf = (stop: ClientGroup) => {
  const logo = stop.profile.logo;
  const ratio = logo ? logo.width / logo.height : 3;
  return ratio >= 3.5 ? "strip" : ratio <= 1.25 ? "block" : "label";
};
---

<ul class="client-wall" aria-label={ui.clientsListLabel}>
  {
    stops.map((stop) => (
      <li>
        <a class="client-tile" href={clientPath(lang, stop.profile.slug)} data-shape={shapeOf(stop)}>
          <span class="client-sticker" aria-hidden="true" />
          {stop.profile.logo ? (
            <ClientLogo class="client-tile-logo" profile={stop.profile} height={180} />
          ) : (
            <span class="client-tile-text" aria-hidden="true">
              {stop.profile.label}
            </span>
          )}
          <span class="sr-only">{ui.viewWorkFor(stop.profile.label)}</span>
        </a>
      </li>
    ))
  }
</ul>
