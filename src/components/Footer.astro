---
import SocialIcon from "./SocialIcon.astro";
import { formspreeEndpoint, legal, SITE_HOST } from "../data/site";
import { getActiveCategories, getSiteContent } from "../lib/content";
import { legalPath, localizePath, t, type Lang } from "../lib/i18n";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const ui = t(lang);
const { socialLinks } = await getSiteContent();
const categories = await getActiveCategories();
const messages = {
  sending: ui.formSending,
  ok: ui.formOk,
  bad: ui.formBad,
  invalid: ui.formInvalid,
  required: ui.formRequired,
  email: ui.formEmailInvalid,
};
---

<footer id="contact" class="contact-footer">
  <div class="container">
    <p class="section-label"><span class="section-number">→</span> {ui.contactKicker}</p>
    <h2 class="cta-title misreg">{ui.ctaTitle}</h2>
  </div>
  <div class="container contact-layout">
    <div class="footer-contact-copy">
      <p class="cta-text">{ui.ctaText}</p>
      {
        (legal.email || legal.phone) && (
          <dl class="contact-direct">
            {legal.email && (
              <div>
                <dt class="spec">{ui.emailLabel}</dt>
                <dd>
                  <a href={`mailto:${legal.email}`}>{legal.email}</a>
                </dd>
              </div>
            )}
            {legal.phone && (
              <div>
                <dt class="spec">{ui.phoneLabel}</dt>
                <dd>
                  <a href={`tel:${legal.phone.replace(/[^+\d]/g, "")}`}>{legal.phone}</a>
                </dd>
              </div>
            )}
          </dl>
        )
      }
      {
        socialLinks.length > 0 && (
          <ul class="social-links" aria-label={ui.social}>
            {socialLinks.map((link) => (
              <li>
                <a href={link.url} rel="me noopener" target="_blank" aria-label={link.label}>
                  <SocialIcon label={link.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="backstage-pass">
      <div class="pass-head" aria-hidden="true">
        <span class="pass-hole"></span>
        <span class="pass-title">{ui.passTitle}</span>
        <span class="pass-access">{ui.passAccess}</span>
      </div>
    <form
      id="contact-form"
      class="contact-form"
      name="contact"
      method="POST"
      action={formspreeEndpoint}
      novalidate
      data-messages={JSON.stringify(messages)}
    >
      <div class="form-field">
        <label for="footer-name">{ui.formName}</label>
        <input id="footer-name" name="name" type="text" autocomplete="name" required aria-describedby="footer-name-error" />
        <p class="field-error" id="footer-name-error"></p>
      </div>
      <div class="form-field">
        <label for="footer-email">{ui.formEmail}</label>
        <input id="footer-email" name="email" type="email" autocomplete="email" required aria-describedby="footer-email-error" />
        <p class="field-error" id="footer-email-error"></p>
      </div>
      <div class="form-field">
        <label for="footer-type">{ui.formType}</label>
        <select id="footer-type" name="projectType">
          <option value="">{ui.formTypeChoose}</option>
          {categories.map((category) => <option value={category.label.de}>{category.label[lang]}</option>)}
          <option value="Sonstiges">{ui.formTypeOther}</option>
        </select>
      </div>
      <div class="form-field contact-message">
        <label for="footer-message">{ui.formMessage}</label>
        <textarea id="footer-message" name="message" rows="4" required aria-describedby="footer-message-error"></textarea>
        <p class="field-error" id="footer-message-error"></p>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden-field" aria-hidden="true" />
      <input type="hidden" name="_subject" value={`Neue Projektanfrage über ${SITE_HOST}`} />
      <input type="hidden" name="language" value={lang} />
      <p class="form-privacy">
        {ui.formPrivacy} <a href={legalPath("datenschutz")}>{ui.privacy}</a>.
      </p>
      <div class="contact-actions">
        <button type="submit" class="btn">{ui.formSend}</button>
        <p id="contact-form-status" class="form-status" role="status" aria-live="polite"></p>
      </div>
    </form>
    </div>
  </div>
  <div class="container footer-meta">
    <span class="footer-brand"><span class="logo-stamp" aria-hidden="true">MB</span> Moritz Barz <span class="spec footer-host">{SITE_HOST}</span></span>
    <nav aria-label={ui.footerNav}>
      <a href={`${localizePath(lang)}#contact`}>{ui.navContact}</a>
      <a href={legalPath("impressum")} hreflang="de">{ui.imprint}</a>
      <a href={legalPath("datenschutz")} hreflang="de">{ui.privacy}</a>
      <a href="#top" class="back-to-top">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M12 3 4 11h5v10h6V11h5z" fill="currentColor"></path>
        </svg>
        {ui.backToTop}
      </a>
    </nav>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  if (form) {
    const status = form.querySelector<HTMLElement>("#contact-form-status")!;
    const submit = form.querySelector<HTMLButtonElement>("[type=submit]");
    const messages = JSON.parse(form.dataset.messages ?? "{}") as Record<string, string>;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")];

    const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const error = document.getElementById(`${field.id}-error`);
      const message = field.validity.valueMissing
        ? messages.required
        : field.validity.typeMismatch
          ? messages.email
          : "";
      field.setAttribute("aria-invalid", String(Boolean(message)));
      if (error) error.textContent = message;
      return !message;
    };

    fields.forEach((field) =>
      field.addEventListener("blur", () => {
        if (field.value || field.getAttribute("aria-invalid") === "true") validate(field);
      }),
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length > 0) {
        status.textContent = messages.invalid;
        invalid[0].focus();
        return;
      }

      if (submit) submit.disabled = true;
      status.textContent = messages.sending;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        if (response.ok) {
          form.reset();
          status.textContent = messages.ok;
        } else {
          status.textContent = messages.bad;
        }
      } catch {
        status.textContent = messages.bad;
      }
      if (submit) submit.disabled = false;
    });
  }
</script>
