---
type Props = {
  simple?: boolean;
};

const { simple = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="navbar" aria-label="Hauptnavigation">
  <div class="nav-container">
    <a href={simple ? `${base}#portfolio` : base} class="logo" aria-label="Moritz Barz Portfolio">
      MORITZ<span>BARZ</span>
    </a>
    {
      simple ? (
        <a class="back-link" href={`${base}#portfolio`}>Zurück zur Arbeit</a>
      ) : (
        <>
          <ul class="nav-links" id="primary-navigation">
            <li><a href="#portfolio">Work</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
          <button class="hamburger" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="primary-navigation">
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
          </button>
        </>
      )
    }
  </div>
</nav>
