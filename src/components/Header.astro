---
import { localizePath, t, type Alternates, type Lang } from "../lib/i18n";

type Props = {
  lang: Lang;
  alternates?: Alternates;
};

const { lang, alternates = {} } = Astro.props;
const ui = t(lang);
const otherLang: Lang = lang === "de" ? "en" : "de";
const languageHref = alternates[otherLang] ?? localizePath(otherLang);
const home = localizePath(lang);
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "/");
const isHome = normalizedPath === home;
const sectionHref = (hash: string) => (isHome ? hash : `${home}${hash}`);
---

<header class="navbar" id="top">
  <nav class="nav-container" aria-label={ui.navLabel}>
    <a href={home} class="logo" aria-label={ui.homeLabel}>
      MORITZ<span>BARZ</span>
    </a>
    <ul class="nav-links" id="primary-navigation">
      <li><a href={sectionHref("#work")} data-section="work">{ui.navWork}</a></li>
      <li><a href={sectionHref("#portfolio")} data-section="portfolio">{ui.clientsKicker}</a></li>
      <li><a href={sectionHref("#about")} data-section="about">{ui.navAbout}</a></li>
      <li><a href={sectionHref("#contact")} data-section="contact">{ui.navContact}</a></li>
    </ul>
    <div class="nav-actions">
      <a class="nav-toggle" href={languageHref} hreflang={otherLang} lang={otherLang} aria-label={ui.switchLanguage}>
        {otherLang.toUpperCase()}
      </a>
      <button
        class="nav-toggle nav-toggle-icon"
        type="button"
        data-theme-toggle
        data-label-light={ui.themeToLight}
        data-label-dark={ui.themeToDark}
        aria-pressed="false"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
          <path
            d="M12 1.8v3M12 19.2v3M1.8 12h3M19.2 12h3M4.8 4.8l2.1 2.1M17.1 17.1l2.1 2.1M4.8 19.2l2.1-2.1M17.1 6.9l2.1-2.1"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="square"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" fill="currentColor"></path>
        </svg>
        <span class="sr-only">{ui.themeToLight}</span>
      </button>
      <button
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-label-open={ui.menuOpen}
        data-label-close={ui.menuClose}
      >
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="sr-only">{ui.menuOpen}</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Highlight the navigation entry of the section currently in view (home page only).
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav-links a[data-section]")];
  const sections = links
    .map((link) => document.getElementById(link.dataset.section ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            if (link.dataset.section === entry.target.id) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          });
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
