---
import { t, type Lang } from "../lib/i18n";

type Props = {
  lang: Lang;
};

const ui = t(Astro.props.lang);
// Template for the per-image counter, filled in client-side.
const countTemplate = ui.imageCount(1, 2).replace("1", "{current}").replace("2", "{total}");
---

<dialog class="lightbox" aria-labelledby="lightbox-title" data-count-template={countTemplate}>
  <div class="lightbox-inner">
    <figure class="lightbox-figure">
      <img class="lightbox-image" src="data:," alt="" />
    </figure>
    <div class="lightbox-caption">
      <p class="spec lightbox-meta"></p>
      <h2 id="lightbox-title" class="lightbox-title"></h2>
      <p class="lightbox-summary"></p>
      <p class="spec lightbox-count"></p>
    </div>
    <div class="lightbox-controls">
      <button type="button" class="lightbox-button" data-lightbox-prev aria-label={ui.lightboxPrev}>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" class="lightbox-button" data-lightbox-next aria-label={ui.lightboxNext}>
        <span aria-hidden="true">→</span>
      </button>
      <button type="button" class="lightbox-button" data-lightbox-close aria-label={ui.lightboxClose}>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
  </div>
</dialog>

<script>
  type Slide = { src: string; alt: string; title: string; meta: string; summary: string; index: number; total: number };

  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");

  if (dialog) {
    const figure = dialog.querySelector<HTMLElement>(".lightbox-figure")!;
    const image = dialog.querySelector<HTMLImageElement>(".lightbox-image")!;
    const title = dialog.querySelector<HTMLElement>(".lightbox-title")!;
    const meta = dialog.querySelector<HTMLElement>(".lightbox-meta")!;
    const summary = dialog.querySelector<HTMLElement>(".lightbox-summary")!;
    const count = dialog.querySelector<HTMLElement>(".lightbox-count")!;
    const countTemplate = dialog.dataset.countTemplate ?? "{current} / {total}";
    let slides: Slide[] = [];
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    // Flatten all visible projects into one slide list: main image first, then the gallery.
    const collectSlides = () => {
      const starts = new Map<HTMLButtonElement, number>();
      const list: Slide[] = [];
      document.querySelectorAll<HTMLButtonElement>("[data-lightbox-item]").forEach((item) => {
        if (item.closest("[hidden]")) return;
        const images = JSON.parse(item.dataset.slides ?? "[]") as { src: string; alt: string }[];
        starts.set(item, list.length);
        images.forEach((entry, index) =>
          list.push({
            ...entry,
            title: item.dataset.title ?? "",
            meta: item.dataset.meta ?? "",
            summary: item.dataset.summary ?? "",
            index,
            total: images.length,
          }),
        );
      });
      return { list, starts };
    };

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      image.src = slide.src;
      image.alt = slide.alt;
      // Restart the photocopier scan for every slide
      figure.classList.remove("is-scanning");
      void figure.offsetWidth;
      figure.classList.add("is-scanning");
      title.textContent = slide.title;
      meta.textContent = slide.meta;
      summary.textContent = slide.summary;
      summary.hidden = !slide.summary;
      count.textContent =
        slide.total > 1 ? countTemplate.replace("{current}", String(slide.index + 1)).replace("{total}", String(slide.total)) : "";
      dialog.querySelectorAll<HTMLButtonElement>("[data-lightbox-prev], [data-lightbox-next]").forEach((button) => {
        button.hidden = slides.length < 2;
      });
    };

    document.addEventListener("click", (event) => {
      const trigger = (event.target as Element).closest<HTMLButtonElement>("[data-lightbox-item]");
      if (!trigger) return;
      const { list, starts } = collectSlides();
      slides = list;
      opener = trigger;
      show(starts.get(trigger) ?? 0);
      dialog.showModal();
    });

    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(current - 1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(current + 1));
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());

    // Click on the backdrop closes the dialog
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    let touchStart: number | null = null;
    dialog.addEventListener("touchstart", (event) => (touchStart = event.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (event) => {
      if (touchStart === null) return;
      const delta = event.changedTouches[0].clientX - touchStart;
      if (Math.abs(delta) > 50) show(current + (delta < 0 ? 1 : -1));
      touchStart = null;
    });

    dialog.addEventListener("close", () => {
      image.src = "data:,";
      opener?.focus();
    });
  }
</script>
