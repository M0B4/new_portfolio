---
import { getImageUrl, getResponsiveImage } from "../lib/images";
import { pick, t, type Lang } from "../lib/i18n";
import type { PortfolioProject } from "../lib/projects";

type Props = {
  project: PortfolioProject;
  lang: Lang;
  categoryLabel: string;
  eager?: boolean;
};

const { project, lang, categoryLabel, eager = false } = Astro.props;
const ui = t(lang);
const image = await getResponsiveImage(project.previewImage, [400, 640, 960]);
const fullImage = await getImageUrl(project.previewImage, 1800);
const title = pick(lang, project.title, project.titleEn);
const shortTitle = pick(lang, project.shortTitle, project.shortTitleEn);
const summary = pick(lang, project.summary, project.summaryEn);
const meta = [categoryLabel, project.clientProfile?.label, project.year].filter(Boolean).join(" / ");
---

<article class="project-card" data-category={project.category}>
  <button
    type="button"
    class="project-card-trigger"
    data-lightbox-item
    data-full={fullImage}
    data-title={title}
    data-meta={meta}
    data-summary={summary}
    data-alt={project.alt}
    aria-label={ui.openProject(title)}
  >
    <figure class="card-image" style={image.placeholder ? `background-image:url(${image.placeholder})` : undefined}>
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 820px) 33vw, 50vw"
        width={image.width}
        height={image.height}
        alt={project.alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </figure>
    <span class="card-info">
      <span class="card-meta">{categoryLabel} / {project.year}</span>
      <span class="card-title">{shortTitle}</span>
    </span>
  </button>
</article>
