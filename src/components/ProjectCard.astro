---
import { getImageUrl, getResponsiveImage } from "../lib/images";
import { pick, t, type Lang } from "../lib/i18n";
import type { PortfolioProject } from "../lib/projects";

type Props = {
  project: PortfolioProject;
  lang: Lang;
  categoryLabel: string;
  eager?: boolean;
  sizes?: string;
};

const { project, lang, categoryLabel, eager = false, sizes = "(min-width: 820px) 33vw, 50vw" } = Astro.props;
const ui = t(lang);
const image = await getResponsiveImage(project.previewImage, [400, 640, 960, 1280]);
const slides = await Promise.all(
  [{ image: project.previewImage, alt: project.alt }, ...project.gallery].map(async (item) => ({
    src: await getImageUrl(item.image, 1800),
    alt: item.alt,
  })),
);
const title = pick(lang, project.title, project.titleEn);
const shortTitle = pick(lang, project.shortTitle, project.shortTitleEn);
const summary = pick(lang, project.summary, project.summaryEn);
const clientLabel = project.clientProfile?.label ?? project.client;
const meta = [categoryLabel, clientLabel, project.year].filter(Boolean).join(" / ");
---

<article class="project-card" data-category={project.category}>
  <button
    type="button"
    class="project-card-trigger"
    data-lightbox-item
    data-slides={JSON.stringify(slides)}
    data-title={title}
    data-meta={[meta, project.specs].filter(Boolean).join(" — ")}
    data-summary={summary}
    aria-label={ui.openProject(title)}
  >
    <span class="print-frame">
      <span class="card-image" style={image.placeholder ? `background-image:url(${image.placeholder})` : undefined}>
        <img
          src={image.src}
          srcset={image.srcset}
          sizes={sizes}
          width={image.width}
          height={image.height}
          alt={project.alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      </span>
      {slides.length > 1 && <span class="card-badge" aria-hidden="true">+{slides.length - 1}</span>}
    </span>
    <span class="card-info">
      <span class="spec">{meta}</span>
      <span class="card-title">{shortTitle}</span>
      {project.specs && <span class="spec spec-quiet">{project.specs}</span>}
    </span>
  </button>
</article>
