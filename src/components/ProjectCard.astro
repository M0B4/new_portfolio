---
import { getResponsiveImage } from "../lib/images";
import { pick, type Lang } from "../lib/i18n";
import type { PortfolioProject } from "../lib/projects";

type Props = {
  project: PortfolioProject;
  lang: Lang;
  categoryLabel: string;
  /** Slug of the client, used by the client filter on the "all work" page. */
  clientSlug?: string;
  eager?: boolean;
  /** Likely LCP element: load with high priority. */
  priority?: boolean;
  sizes?: string;
};

const {
  project,
  lang,
  categoryLabel,
  clientSlug,
  eager = false,
  priority = false,
  sizes = "(min-width: 820px) 33vw, 50vw",
} = Astro.props;
const image = await getResponsiveImage(project.previewImage, [400, 560, 640, 720, 960, 1280], { quality: 72 });
const shortTitle = pick(lang, project.shortTitle, project.shortTitleEn);
const summary = pick(lang, project.summary, project.summaryEn);
const clientLabel = project.clientProfile.label;
const meta = [clientLabel, categoryLabel, project.year].filter(Boolean).join(" / ");
---

<article class="project-card" data-category={project.category} data-client={clientSlug}>
  <div class="project-card-body">
    <span class:list={["card-image", { "has-cutout": image.transparent }]}>
      <img
        class={image.transparent ? "is-cutout" : undefined}
        src={image.src}
        srcset={image.srcset}
        sizes={sizes}
        width={image.width}
        height={image.height}
        alt={project.alt === project.title ? "" : project.alt}
        loading={eager || priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    </span>
    <span class="card-info">
      <span class="spec card-meta">{meta}</span>
      <span class="card-title">{shortTitle}</span>
      {summary && <span class="card-summary">{summary}</span>}
    </span>
  </div>
</article>
