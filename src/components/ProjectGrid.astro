---
import ProjectCard from "./ProjectCard.astro";
import Lightbox from "./Lightbox.astro";
import type { CategoryInfo } from "../data/site";
import { t, type Lang } from "../lib/i18n";
import type { PortfolioProject } from "../lib/projects";

type Props = {
  projects: PortfolioProject[];
  categories: CategoryInfo[];
  lang: Lang;
  filterable?: boolean;
  /** Number of columns on wide screens. */
  columns?: 2 | 3;
  /** Render the lightbox dialog. Pages with several grids render it only once. */
  lightbox?: boolean;
  eagerCount?: number;
};

const { projects, categories, lang, filterable = false, columns = 3, lightbox = true, eagerCount = 3 } = Astro.props;
const ui = t(lang);
const labelFor = (value: string) => categories.find((category) => category.value === value)?.label[lang] ?? value;
const presentCategories = categories.filter((category) => projects.some((project) => project.category === category.value));
const showFilter = filterable && presentCategories.length > 1;
const sizes = columns === 2 ? "(min-width: 820px) 50vw, 100vw" : "(min-width: 820px) 33vw, 50vw";
---

<div class="project-grid-wrapper" data-project-grid>
  {
    showFilter && (
      <div class="grid-filter" role="group" aria-label={ui.filterLabel}>
        <button type="button" class="filter-button" data-filter="all" aria-pressed="true">
          {ui.filterAll} <span class="filter-count">{projects.length}</span>
        </button>
        {presentCategories.map((category) => (
          <button type="button" class="filter-button" data-filter={category.value} aria-pressed="false">
            {category.label[lang]}{" "}
            <span class="filter-count">{projects.filter((project) => project.category === category.value).length}</span>
          </button>
        ))}
      </div>
    )
  }
  <div class:list={["client-work-grid", { "grid-two": columns === 2 }]}>
    {
      projects.map((project, index) => (
        <ProjectCard
          project={project}
          lang={lang}
          categoryLabel={labelFor(project.category)}
          eager={index < eagerCount}
          sizes={sizes}
        />
      ))
    }
  </div>
</div>
{lightbox && <Lightbox lang={lang} />}

<script>
  document.querySelectorAll<HTMLElement>("[data-project-grid]").forEach((grid) => {
    const buttons = grid.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = grid.querySelectorAll<HTMLElement>(".project-card");

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        cards.forEach((card) => {
          card.hidden = filter !== "all" && card.dataset.category !== filter;
        });
      }),
    );
  });
</script>
