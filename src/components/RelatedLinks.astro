---
type Props = {
  title: string;
  links: { label: string; href: string }[];
};

const { title, links } = Astro.props;
const id = `related-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

{
  links.length > 0 && (
    <nav class="section related-section" aria-labelledby={id}>
      <div class="container">
        <h2 id={id} class="related-title">
          {title}
        </h2>
        <ul class="related-links">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
