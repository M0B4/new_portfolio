---
// Section heading: large blackletter number in gold, mono kicker, Archivo headline.
type Props = {
  id: string;
  number?: string;
  kicker: string;
  title: string;
  text?: string;
};

const { id, number, kicker, title, text } = Astro.props;
---

<div class:list={["section-heading", { "section-heading-split": text }]}>
  {number && <span class="section-numeral" aria-hidden="true">{number}</span>}
  <div class="section-heading-copy">
    <p class="section-label">{kicker}</p>
    <h2 id={id}>{title}</h2>
  </div>
  {text && <p class="section-heading-text">{text}</p>}
</div>
