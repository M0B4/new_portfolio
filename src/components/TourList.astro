---
// Clients as tour dates on the back of a band shirt: NAME ······ YEARS · FIELDS.
import ClientLogo from "./ClientLogo.astro";
import type { TourStop } from "../lib/content";
import { clientPath, t, type Lang } from "../lib/i18n";
import { getResponsiveImage } from "../lib/images";

type Props = {
  stops: TourStop[];
  lang: Lang;
};

const { stops, lang } = Astro.props;
const ui = t(lang);
const rows = await Promise.all(
  stops.map(async (stop) => ({
    stop,
    preview: await getResponsiveImage(stop.projects[0].previewImage, [320, 480], { quality: 70 }),
  })),
);
---

<ol class="tour-list">
  {
    rows.map(({ stop, preview }) => (
      <li class="tour-row">
        <a class="tour-link" href={clientPath(lang, stop.profile.slug)}>
          <span class="tour-main">
            <span class="tour-name">{stop.profile.label}</span>
            <span class="tour-leader" aria-hidden="true" />
          </span>
          <span class="tour-years">{stop.years}</span>
          <span class="tour-fields spec">
            {stop.categories.map((category) => category.label[lang]).join(" / ")}
            <span class="sr-only">, {ui.projectCount(stop.projects.length)}</span>
          </span>
          <span class="tour-preview" aria-hidden="true">
            <img
              class="halftone"
              src={preview.src}
              srcset={preview.srcset}
              sizes="240px"
              width={preview.width}
              height={preview.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <ClientLogo class="tour-logo" profile={stop.profile} height={36} />
          </span>
        </a>
      </li>
    ))
  }
</ol>
