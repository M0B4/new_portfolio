---
import "@sarap422/font-dinish/font-face.css";
import "@fontsource/saira-stencil-one/latin.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { fetchSiteSettings } from "../lib/sanity/client";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = "Moritz Barz | Heavy Design, Merch & 3D-Print",
  description = "Portfolio von Moritz Barz: Poster, Merchandise, Eventdesign und funktionale 3D-Prints für Metal-Szene, Festivals und Tauchsport.",
  image = "images/header.jpg",
  structuredData,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  if (path.startsWith("http")) return path;
  if (path.startsWith(base)) return path;
  return `${base}${path.replace(/^\/+/, "")}`;
};
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const absoluteImage = new URL(withBase(image), Astro.site ?? Astro.url.origin);
const siteName = "Moritz Barz Portfolio";
const siteSettings = await fetchSiteSettings();
const hexToRgb = (hex?: string) => {
  const match = hex?.match(/^#([0-9a-fA-F]{6})$/);
  if (!match) return null;
  const value = Number.parseInt(match[1], 16);
  return `${(value >> 16) & 255}, ${(value >> 8) & 255}, ${value & 255}`;
};
const accentDark = siteSettings?.accentDark?.match(/^#[0-9a-fA-F]{6}$/) ? siteSettings.accentDark : "#e1262f";
const accentLight = siteSettings?.accentLight?.match(/^#[0-9a-fA-F]{6}$/) ? siteSettings.accentLight : "#b40f1d";
const accentDarkRgb = hexToRgb(accentDark) ?? "225, 38, 47";
const accentLightRgb = hexToRgb(accentLight) ?? "180, 15, 29";
const textureOpacity = Math.min(Math.max(siteSettings?.backgroundTextureOpacity ?? 0.1, 0), 1);
const settingsCss = `:root{--accent:${accentDark};--accent-soft:rgba(${accentDarkRgb},0.18);--accent-line:rgba(${accentDarkRgb},0.5);--texture-opacity:${textureOpacity};}:root[data-theme="light"]{--accent:${accentLight};--accent-soft:rgba(${accentLightRgb},0.14);--accent-line:rgba(${accentLightRgb},0.42);}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Moritz Barz" />
    <meta name="application-name" content={siteName} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "dark";
        const language = localStorage.getItem("language") || "de";
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.language = language;
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ece8df" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-icon-180x180.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <style is:inline set:html={settingsCss}></style>
    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body>
    <slot />
    <Footer />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const getLanguage = () => localStorage.getItem("language") || "de";
        const getTheme = () => localStorage.getItem("theme") || "dark";

        const applyLanguage = (language) => {
          root.dataset.language = language;
          document.documentElement.lang = language;
          localStorage.setItem("language", language);

          document.querySelectorAll("[data-i18n-de][data-i18n-en]").forEach((element) => {
            const value = element.dataset[language === "en" ? "i18nEn" : "i18nDe"];
            if (value) element.textContent = value;
          });

          document.querySelectorAll("[data-language-toggle]").forEach((button) => {
            button.textContent = language === "en" ? "DE" : "EN";
            button.setAttribute("aria-pressed", String(language === "en"));
            button.setAttribute("aria-label", language === "en" ? "Switch to German" : "Sprache auf Englisch wechseln");
          });
        };

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          localStorage.setItem("theme", theme);

          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            const isLight = theme === "light";
            button.textContent = isLight ? "●" : "☼";
            button.setAttribute("aria-pressed", String(isLight));
            button.setAttribute("aria-label", isLight ? "Dark Mode aktivieren" : "Light Mode aktivieren");
          });
        };

        applyLanguage(getLanguage());
        applyTheme(getTheme());

        document.querySelectorAll("[data-language-toggle]").forEach((button) => {
          button.addEventListener("click", () => applyLanguage(getLanguage() === "en" ? "de" : "en"));
        });

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => applyTheme(getTheme() === "light" ? "dark" : "light"));
        });

        const hamburger = document.querySelector(".hamburger");
        const navLinks = document.querySelector(".nav-links");

        hamburger?.addEventListener("click", () => {
          const isOpen = hamburger.classList.toggle("active");
          navLinks?.classList.toggle("active", isOpen);
          hamburger.setAttribute("aria-expanded", String(isOpen));
          hamburger.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
        });

        navLinks?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            hamburger?.classList.remove("active");
            navLinks.classList.remove("active");
            hamburger?.setAttribute("aria-expanded", "false");
            hamburger?.setAttribute("aria-label", "Menü öffnen");
          });
        });
      })();
    </script>
  </body>
</html>
