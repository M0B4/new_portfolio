---
import "@fontsource-variable/archivo/standard.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/unifrakturmaguntia/latin-400.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import monoFont from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import sansFont from "@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url";
import Footer from "../components/Footer.astro";
import { plausibleDomain, SITE_NAME, OWNER_NAME } from "../data/site";
import { getSiteContent } from "../lib/content";
import { htmlLang, ogLocale, pick, t, type Alternates, type Lang } from "../lib/i18n";
import { assetUrl, basePath as base } from "../lib/url";

type Props = {
  lang: Lang;
  title?: string;
  description?: string;
  /** Absolute URL or base-relative path of the Open Graph image. */
  image?: string;
  imageAlt?: string;
  alternates?: Alternates;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
};

const { settings } = await getSiteContent();
const {
  lang,
  title = `${OWNER_NAME} | ${pick(lang, "Grafikdesign für Festivals & Bands", "Graphic design for festivals & bands")}`,
  description = pick(
    lang,
    settings.description ||
      "Moritz Barz gestaltet Poster, Merch und Eventdesign für Festivals, Bands und die Metal-Szene, dazu funktionale Teile aus dem 3D-Drucker.",
    settings.descriptionEn ||
      "Moritz Barz designs posters, merch and event visuals for festivals, bands and the metal scene, plus functional 3D-printed parts.",
  ),
  image = "images/header.jpg",
  imageAlt = title,
  alternates = {},
  structuredData,
  noindex = false,
} = Astro.props;

const ui = t(lang);
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const absoluteImage = new URL(assetUrl(image), origin);
const alternateLinks = Object.entries(alternates).map(([hreflang, path]) => ({
  hreflang,
  href: new URL(path, origin).toString(),
}));
const defaultAlternate = alternateLinks.find((link) => link.hreflang === "de");

// The gold accent is part of the design system; only the paper grain is adjustable in Sanity.
const textureOpacity = Math.min(Math.max(settings.backgroundTextureOpacity ?? 0.1, 0), 1);
const settingsCss = `:root{--texture-opacity:${textureOpacity};}`;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER_NAME} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        // Paper is the default look; dark mode only when chosen via the toggle.
        if (theme !== "light" && theme !== "dark") theme = "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://cdn.sanity.io" />
    {
      [sansFont, monoFont].map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <meta name="theme-color" content="#f2ede3" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === "de" ? "en" : "de"]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-icon-180x180.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <style is:inline set:html={settingsCss}></style>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">{ui.skip}</a>
    <slot />
    <Footer lang={lang} />
    <script>
      const root = document.documentElement;

      // Theme toggle
      const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
      const applyTheme = (theme: string) => {
        root.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {}
        themeButtons.forEach((button) => {
          const isLight = theme === "light";
          button.setAttribute("aria-pressed", String(isLight));
          const label = button.querySelector(".sr-only");
          if (label) label.textContent = (isLight ? button.dataset.labelDark : button.dataset.labelLight) ?? "";
        });
      };
      applyTheme(root.dataset.theme === "light" ? "light" : "dark");
      themeButtons.forEach((button) =>
        button.addEventListener("click", () => applyTheme(root.dataset.theme === "light" ? "dark" : "light")),
      );

      // Mobile menu: Esc closes, background is inert while open
      const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
      const navLinks = document.querySelector<HTMLElement>(".nav-links");
      const background = document.querySelectorAll<HTMLElement>("main, footer");

      const setMenu = (open: boolean, restoreFocus = false) => {
        if (!hamburger || !navLinks) return;
        hamburger.classList.toggle("active", open);
        navLinks.classList.toggle("active", open);
        hamburger.setAttribute("aria-expanded", String(open));
        const label = hamburger.querySelector(".sr-only");
        if (label) label.textContent = (open ? hamburger.dataset.labelClose : hamburger.dataset.labelOpen) ?? "";
        background.forEach((element) => (element.inert = open));
        if (open) navLinks.querySelector("a")?.focus();
        if (!open && restoreFocus) hamburger.focus();
      };

      hamburger?.addEventListener("click", () => setMenu(hamburger.getAttribute("aria-expanded") !== "true"));
      navLinks?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && hamburger?.getAttribute("aria-expanded") === "true") setMenu(false, true);
      });
      window.matchMedia("(min-width: 861px)").addEventListener("change", (event) => {
        if (event.matches) setMenu(false);
      });
    </script>
  </body>
</html>
