---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { legal, plausibleDomain } from "../data/site";
import { legalPath } from "../lib/i18n";

// TODO: Diese Datenschutzerklärung inhaltlich und rechtlich prüfen lassen.
const alternates = { de: legalPath("datenschutz") };
---

<BaseLayout lang="de" title="Datenschutz | Moritz Barz" description="Datenschutzerklärung der Portfolio-Website von Moritz Barz." alternates={alternates}>
  <Header lang="de" alternates={alternates} />

  <main id="main" class="legal-page">
    <section class="section">
      <div class="container legal-layout">
        <p class="section-label">Datenschutz</p>
        <div class="legal-content">
          <h1>Datenschutzerklärung</h1>
          <p>
            Diese Website ist ein statisches Portfolio. Es werden keine personenbezogenen Daten für Tracking, Profiling
            oder Werbung verwendet.
          </p>

          <h2>Verantwortlicher</h2>
          <p>
            {legal.name}<br />
            {legal.street}<br />
            {legal.city}
            {legal.email && <><br />E-Mail: <a href={`mailto:${legal.email}`}>{legal.email}</a></>}
          </p>

          <h2>Hosting</h2>
          <p>
            Die Website wird als statischer Webauftritt bei Cloudflare Pages (Cloudflare, Inc., USA) gehostet. Beim
            Aufruf verarbeitet der Hosting-Anbieter technisch notwendige Daten wie IP-Adresse, Zeitpunkt und aufgerufene
            Seite (Art. 6 Abs. 1 lit. f DSGVO). Cloudflare ist unter dem EU-US Data Privacy Framework zertifiziert.
            Weitere Informationen finden Sie in der
            <a href="https://www.cloudflare.com/privacypolicy/">Datenschutzerklärung von Cloudflare</a>.
          </p>

          <h2>Kontaktformular</h2>
          <p>
            Über das Kontaktformular können Nachrichten hinterlassen werden. Das Formular wird von
            <a href="https://formspree.io/legal/privacy-policy">Formspree</a> (Formspree Inc., USA) verarbeitet. Die Angaben
            werden ausschließlich zur Bearbeitung Ihrer Anfrage verwendet (Art. 6 Abs. 1 lit. b DSGVO) und nicht an Dritte
            verkauft.
          </p>

          {
            plausibleDomain && (
              <>
                <h2>Reichweitenmessung</h2>
                <p>
                  Zur anonymen Reichweitenmessung wird Plausible Analytics (Plausible Insights OÜ, Estland) eingesetzt.
                  Plausible verwendet keine Cookies und speichert keine personenbezogenen Daten; IP-Adressen werden nur
                  gehasht und nicht gespeichert (Art. 6 Abs. 1 lit. f DSGVO).
                </p>
              </>
            )
          }

          <h2>Cookies &amp; lokale Speicherung</h2>
          <p>
            Die Website verwendet keine Cookies. Das gewählte Farbschema (dunkel/hell) wird ausschließlich im lokalen
            Speicher (localStorage) Ihres Browsers gespeichert und nicht übertragen.
          </p>

          <h2>Schriftarten</h2>
          <p>Web-Schriftarten werden lokal von dieser Website ausgeliefert, es werden keine externen Font-Dienste genutzt.</p>

          <h2>Ihre Rechte</h2>
          <p>
            Sie haben gemäß DSGVO das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung,
            Datenübertragbarkeit und Widerspruch sowie das Recht auf Beschwerde bei einer Datenschutz-Aufsichtsbehörde.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
