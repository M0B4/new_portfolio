---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

const base = import.meta.env.BASE_URL;
const title = "Datenschutz | Moritz Barz";
const description = "Datenschutzerklärung der Portfolio-Website von Moritz Barz.";
---
<!-- TODO: Diese Datenschutzerklärung inhaltlich und rechtstechnisch prüfen lassen -->
<BaseLayout title={title} description={description}>
  <Header />

  <main id="main" class="legal-page">
    <section class="section">
      <div class="container legal-layout">
        <p class="kicker" data-i18n-de="Datenschutz" data-i18n-en="Privacy">Datenschutz</p>
        <div class="legal-content">
          <h1>Datenschutzerklärung</h1>
          <p>
            Diese Website ist ein statisches Portfolio. Es werden keine personenbezogenen
            Daten für Tracking, Profiling oder Werbung verwendet.
          </p>

          <h2>Verantwortlicher</h2>
          <!-- TODO: echte Anschrift ergänzen -->
          <p>Moritz Barz<br />Straße, 12345 Stadt</p>

          <h2>Hosting</h2>
          <p>
            Die Website wird als statischer Webauftritt bei GitHub Pages gehostet. Beim
            Aufruf werden technisch notwendige Daten vom Hosting-Anbieter verarbeitet.
            Weitere Informationen finden Sie in der
            <a href="https://docs.github.com/site-policy/privacy">Datenschutzerklärung von GitHub</a>.
          </p>

          <h2>Kontaktformular</h2>
          <p>
            Über das Kontaktformular können Nachrichten hinterlassen werden. Das Formular
            wird von <a href="https://formspree.io">Formspree</a> verarbeitet. Die Angaben
            werden ausschließlich zur Bearbeitung Ihrer Anfrage verwendet und nicht für
            Weiteres gespeichert oder an Dritte verkauft.
          </p>

          <h2>Cookies &amp; lokale Speicherung</h2>
          <p>
            Die Website verwendet keine Cookies. Für das Farbschema (dunkel/hell) und die
            Sprache (Deutsch/Englisch) werden Ihre Einstellungen ausschließlich im lokalen
            Speicher (localStorage) Ihres Browsers gespeichert. Diese Angaben sind nicht
            personenbezogen und werden nicht an Dritte übertragen.
          </p>

          <h2>Schriftarten &amp; Medien</h2>
          <p>
            Web-Schriftarten werden lokal ausgeliefert (keine externen CDNs). Bilddateien
            werden für verschiedene Bildgrößen optimiert.
          </p>

          <h2>Ihre Rechte</h2>
          <p>
            Sie haben gemäß DSGVO das Recht auf Auskunft, Berichtigung, Löschung und
            Widerspruch. Anfragen richten Sie bitte über das Kontaktformular.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>