---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { legal } from "../data/site";
import { legalPath, localizePath } from "../lib/i18n";

const alternates = { de: legalPath("impressum") };
---

<BaseLayout lang="de" title="Impressum | Moritz Barz" description="Impressum der Portfolio-Website von Moritz Barz." alternates={alternates}>
  <Header lang="de" alternates={alternates} />

  <main id="main" class="legal-page">
    <section class="section">
      <div class="container legal-layout">
        <p class="section-label">Impressum</p>
        <div class="legal-content">
          <h1>Angaben gemäß § 5 DDG</h1>
          <p>
            {legal.name}<br />
            {legal.street}<br />
            {legal.city}<br />
            {legal.country}
          </p>

          <h2>Kontakt</h2>
          <p>
            {legal.email && <>E-Mail: <a href={`mailto:${legal.email}`}>{legal.email}</a><br /></>}
            {legal.phone && <>Telefon: {legal.phone}<br /></>}
            Alternativ über das <a href={`${localizePath("de")}#contact`}>Kontaktformular</a>.
          </p>

          {
            legal.vatId && (
              <>
                <h2>Umsatzsteuer-ID</h2>
                <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {legal.vatId}</p>
              </>
            )
          }

          <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
          <p>{legal.name}, Anschrift wie oben</p>

          <h2>Datenschutz</h2>
          <p><a href={legalPath("datenschutz")}>Datenschutzerklärung</a></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
