---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { getClientGroups } from "../lib/clients";

const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const clientGroups = getClientGroups(projects);
const base = import.meta.env.BASE_URL;
const clientUrl = (slug: string) => `${base}kunden/${slug}/`;

const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Moritz Barz",
  description: "Portfolio von Moritz Barz: Poster, Merchandise, Eventdesign und funktionale 3D-Prints.",
  url: Astro.site?.toString(),
  areaServed: "DE",
  serviceType: ["Poster Design", "Merchandise Design", "Event Design", "3D-Printing"],
};
---

<BaseLayout structuredData={homeStructuredData}>
  <Header />

  <main class="home">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-panel">
          <p class="kicker" data-i18n-de="Portfolio für Szene, Bühne und Einsatz" data-i18n-en="Portfolio for scene, stage and real use">Portfolio für Szene, Bühne und Einsatz</p>
          <div class="hero-copy">
            <h1 id="hero-title" data-i18n-de="Arbeiten, die erst wirken und dann bleiben." data-i18n-en="Work that hits first and stays after.">Arbeiten, die erst wirken und dann bleiben.</h1>
            <p data-i18n-de="Poster, Merch, Eventgrafik und funktionale 3D-Objekte mit harter Kante, klarer Hierarchie und echtem Nutzwert." data-i18n-en="Posters, merch, event graphics and functional 3D objects with a hard edge, clear hierarchy and real use.">Poster, Merch, Eventgrafik und funktionale 3D-Objekte mit harter Kante, klarer Hierarchie und echtem Nutzwert.</p>
          </div>
          <div class="hero-actions" aria-label="Schnelleinstieg">
            <a class="btn" href="#portfolio" data-i18n-de="Portfolio ansehen" data-i18n-en="View portfolio">Portfolio ansehen</a>
            <a class="btn btn-secondary" href="#contact" data-i18n-de="Projekt anfragen" data-i18n-en="Start a project">Projekt anfragen</a>
          </div>
        </div>
      </div>
    </section>

    <section id="portfolio" class="section portfolio-section">
      <div class="container">
        <div class="client-grid" aria-label="Kunden und Kontexte">
          {clientGroups.map((group, index) => {
            return (
              <a class="client-card" href={clientUrl(group.profile.slug)} aria-label={`${group.profile.label} Arbeiten ansehen`}>
                <figure class="client-logo-mark" aria-hidden="true">
                  <img src={`${base}${group.profile.logo}`} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                </figure>
                <span class="client-card-label">{group.profile.label}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section id="about" class="section statement-section">
      <div class="container statement-layout">
        <div class="statement-content">
          <p class="kicker" data-i18n-de="Profil" data-i18n-en="Profile">Profil</p>
          <h2 data-i18n-de="Visuelle Arbeiten, die draußen funktionieren." data-i18n-en="Visual work built for the real world.">Visuelle Arbeiten, die draußen funktionieren.</h2>
          <p>
            <span data-i18n-de="Ich verbinde Heavy-Metal-Ästhetik mit klarer Informationshierarchie und sauberer Produktion. Entscheidend ist ein Auftritt, der Charakter hat und trotzdem lesbar, nutzbar und übergabefähig bleibt." data-i18n-en="I combine heavy metal aesthetics with clear information hierarchy and clean production. The goal is work with character that still stays readable, usable and ready to hand over.">Ich verbinde Heavy-Metal-Ästhetik mit klarer Informationshierarchie und sauberer Produktion. Entscheidend ist ein Auftritt, der Charakter hat und trotzdem lesbar, nutzbar und übergabefähig bleibt.</span>
          </p>
        </div>
        <figure class="statement-portrait" aria-hidden="true">
          <img src={`${base}images/header.jpg`} alt="" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

  </main>

  <script>
    const hamburger = document.querySelector(".hamburger");
    const navLinks = document.querySelector(".nav-links");

    hamburger?.addEventListener("click", () => {
      const isOpen = hamburger.classList.toggle("active");
      navLinks?.classList.toggle("active", isOpen);
      hamburger.setAttribute("aria-expanded", String(isOpen));
      hamburger.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
    });

    navLinks?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        hamburger?.classList.remove("active");
        navLinks.classList.remove("active");
        hamburger?.setAttribute("aria-expanded", "false");
        hamburger?.setAttribute("aria-label", "Menü öffnen");
      });
    });
  </script>
</BaseLayout>
