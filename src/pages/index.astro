---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroSource from "../assets/header.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { categoryLabels, formspreeEndpoint, partners } from "../data/site";

const categories = Object.entries(categoryLabels);
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.slice(0, 3);
const base = import.meta.env.BASE_URL;
const projectWorlds = [
  {
    label: "Poster Wall",
    title: "Eventgrafik mit Druck",
    text: "Plakate, Social Motive und Keyvisuals, die schnell zünden und trotzdem Informationen sauber tragen.",
    filter: "poster",
  },
  {
    label: "Merch Table",
    title: "Tragbare Identität",
    text: "Shirts, Bändchen und Festivalobjekte, die nicht wie Nebenprodukte wirken, sondern wie begehrte Erinnerungen.",
    filter: "clothing",
  },
  {
    label: "Workshop",
    title: "Funktion trifft Haltung",
    text: "3D-Prints und Objektgrafik für reale Nutzung: markieren, schützen, organisieren, wiedererkennen.",
    filter: "3d-print",
  },
];
const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Moritz Barz",
  description: "Poster, Merchandise, Eventdesign und funktionale 3D-Prints für Metal, Festivals und Tauchsport.",
  url: Astro.site?.toString(),
  areaServed: "DE",
  serviceType: ["Poster Design", "Merchandise Design", "Event Design", "3D-Printing"],
};
---

<BaseLayout structuredData={homeStructuredData}>
  <Header />

  <main>
    <header class="hero">
      <Image src={heroSource} alt="" width={1800} height={1013} class="hero-media" loading="eager" decoding="async" aria-hidden="true" />
      <div class="container hero-inner">
        <p class="eyebrow">Portfolio / Merch / Poster / 3D-Print</p>
        <h1>Design für Dinge, die gesehen werden müssen.</h1>
        <p class="hero-subline">Ich entwickle Festivalgrafik, Merch, Poster und funktionale 3D-Prints mit Szene-Energie, klarer Hierarchie und echtem Einsatzwert.</p>
        <div class="hero-actions">
          <a class="btn hero-cta" href="#headliners">Headliner ansehen</a>
          <a class="btn btn-secondary" href="#portfolio">Alle Projekte</a>
        </div>
        <dl class="hero-stats" aria-label="Portfolio Schwerpunkte">
          <div><dt>01</dt><dd>Festival & Event</dd></div>
          <div><dt>02</dt><dd>Merch & Objektgrafik</dd></div>
          <div><dt>03</dt><dd>Funktionale 3D-Prints</dd></div>
        </dl>
      </div>
    </header>

    <section class="proof-strip" aria-label="Kurzprofil">
      <div class="container proof-grid">
        <p><strong>Wacken Open Air</strong><span>Merchandise und Objektgrafik für Festival-Kontexte.</span></p>
        <p><strong>DLRG Einsatzmaterial</strong><span>3D-Druckteile, die nicht nur gut aussehen, sondern funktionieren müssen.</span></p>
        <p><strong>Metal im Dorf</strong><span>Poster und Eventmotive mit Szene-Energie und klarer Lesbarkeit.</span></p>
      </div>
    </section>

    <section class="partners-ribbon" aria-labelledby="partner-title">
      <div class="container">
        <h2 id="partner-title" class="partner-title">Trusted by</h2>
        <div class="logo-grid">
          {partners.map((partner) => <img src={`${base}${partner.logo}`} alt={partner.name} loading="lazy" decoding="async" />)}
        </div>
      </div>
    </section>

    <section id="headliners" class="section headliner-section">
      <div class="container">
        <div class="section-heading section-heading-wide">
          <div>
            <p class="eyebrow">Headliner</p>
            <h2 class="section-title">Die stärksten Arbeiten zuerst.</h2>
          </div>
          <p>Diese Projekte zeigen am besten, worum es geht: laute Gestaltung, klare Funktion und Motive, die auch außerhalb des Screens funktionieren.</p>
        </div>
        <div class="headliner-grid">
          {featuredProjects.map((project, index) => (
            <a class:list={["headliner-card", { "headliner-card-primary": index === 0 }]} href={`${base}work/${project.id.replace(/\.md$/, "")}/`}>
              <Image src={project.data.heroImage} alt={project.data.title} widths={[700, 1100, 1600]} sizes={index === 0 ? "(min-width: 1000px) 58vw, 100vw" : "(min-width: 1000px) 28vw, 100vw"} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <div class="headliner-content">
                <span>{String(index + 1).padStart(2, "0")} / {categoryLabels[project.data.category]}</span>
                <h3>{project.data.shortTitle}</h3>
                <p>{project.data.impact}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section worlds-section">
      <div class="container">
        <div class="section-heading section-heading-wide">
          <div>
            <p class="eyebrow">Design Worlds</p>
            <h2 class="section-title">Drei Bühnen für deine Projekte.</h2>
          </div>
          <p>Damit die Seite nicht nur Arbeiten sammelt, sondern deine Bandbreite klar lesbar macht: Poster, Merch und funktionale Objekte bekommen je eine eigene Rolle.</p>
        </div>
        <div class="worlds-grid">
          {projectWorlds.map((world) => (
            <a class="world-card" href="#portfolio" data-world-filter={world.filter}>
              <span>{world.label}</span>
              <h3>{world.title}</h3>
              <p>{world.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="portfolio" class="section portfolio-section">
      <div class="container">
        <div class="section-heading section-heading-wide">
          <div>
            <p class="eyebrow">Archive</p>
            <h2 class="section-title">Alle Projekte im Zugriff.</h2>
          </div>
          <p>Das Grid bleibt der Kern der Seite: schnell scannbar, filterbar und direkt auf die Projektseiten führend.</p>
        </div>
        <div class="filter-controls" aria-label="Portfolio filtern">
          {
            categories.map(([key, label], index) => (
              <button class:list={["filter-btn", { active: index === 0 }]} type="button" data-filter={key} aria-pressed={index === 0 ? "true" : "false"}>
                {label}
              </button>
            ))
          }
        </div>
        <div class="gallery-grid" id="project-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
        <p class="empty-state" id="empty-state" hidden>Keine Arbeiten in dieser Kategorie gefunden.</p>
      </div>
    </section>

    <section id="about" class="section bg-alt">
      <div class="container split-section">
        <div>
          <p class="eyebrow">Persönlichkeit</p>
          <h2 class="section-title">Ich gestalte wie jemand, der die Szene kennt.</h2>
        </div>
        <div class="copy-block">
          <p>
            Ich komme aus der Metalszene und aus dem Tauchen. Beides ist direkter, ehrlicher und anspruchsvoller, als es von außen wirkt. Ein Festivalmotiv muss in Sekunden zünden. Ein 3D-gedrucktes Teil muss passen, halten und im Alltag Sinn ergeben.
          </p>
          <p>
            Genau da arbeite ich gern: an der Stelle, an der Gestaltung nicht dekoriert, sondern etwas klärt. Für Bands, Festivals, Vereine, Tauchbasen und Marken, die eine visuelle Sprache brauchen, die nicht weichgespült klingt.
          </p>
          <div class="principle-grid">
            <span>laut, wenn es laut sein muss</span>
            <span>präzise, wenn Funktion zählt</span>
            <span>nah an der Szene statt generisch</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Ablauf</p>
          <h2 class="section-title">Vom ersten Riff bis zur fertigen Datei.</h2>
        </div>
        <ol class="process-list">
          <li><strong>Kontext klären</strong><span>Worum geht es, wo wird es genutzt, wer muss es verstehen?</span></li>
          <li><strong>Motiv entwickeln</strong><span>Look, Hierarchie und Funktion werden zusammen gedacht.</span></li>
          <li><strong>Finalisieren</strong><span>Printdaten, Social Assets oder 3D-Druckdateien gehen sauber raus.</span></li>
        </ol>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Bereit für den nächsten Slot?</h2>
          <p class="contact-copy">Schick mir kurz, worum es geht: Event, Merch, Poster, 3D-Print oder etwas dazwischen. Ich antworte mit Rückfragen, einer Einschätzung und dem nächsten sinnvollen Schritt.</p>
          <ul class="contact-notes">
            <li>Ideal für Festivals, Bands, Vereine und Tauchprojekte</li>
            <li>Von Einzelmotiv bis kleiner visueller Serie</li>
            <li>Direkt, klar und ohne Agenturtheater</li>
          </ul>
        </div>
        <form class="contact-form" name="contact" method="POST" action={formspreeEndpoint}>
          <label for="name">Name / Brand</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <label for="message">Projektanfrage</label>
          <textarea id="message" name="message" rows="5" required></textarea>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden-field" />
          <input type="hidden" name="_subject" value="Neue Projektanfrage über moritzbarz.de" />
          <button type="submit" class="btn">Send Message</button>
        </form>
      </div>
    </section>
  </main>

  <script>
    const hamburger = document.querySelector(".hamburger");
    const navLinks = document.querySelector(".nav-links");
    const filterButtons = document.querySelectorAll(".filter-btn");
    const projectCards = document.querySelectorAll(".project-card");
    const emptyState = document.querySelector("#empty-state");
    const worldCards = document.querySelectorAll("[data-world-filter]");

    const applyFilter = (filter) => {
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        const isActive = item.getAttribute("data-filter") === filter;
        item.classList.toggle("active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });

      projectCards.forEach((card) => {
        const isVisible = filter === "all" || card.getAttribute("data-category") === filter;
        card.toggleAttribute("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
    };

    hamburger?.addEventListener("click", () => {
      const isOpen = hamburger.classList.toggle("active");
      navLinks?.classList.toggle("active", isOpen);
      hamburger.setAttribute("aria-expanded", String(isOpen));
      hamburger.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
    });

    navLinks?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        hamburger?.classList.remove("active");
        navLinks.classList.remove("active");
        hamburger?.setAttribute("aria-expanded", "false");
        hamburger?.setAttribute("aria-label", "Menü öffnen");
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        applyFilter(filter || "all");
      });
    });

    worldCards.forEach((card) => {
      card.addEventListener("click", () => {
        const filter = card.getAttribute("data-world-filter");
        applyFilter(filter || "all");
      });
    });
  </script>
</BaseLayout>
