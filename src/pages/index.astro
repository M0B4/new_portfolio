---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroSource from "../assets/header.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { categoryLabels, formspreeEndpoint, partners } from "../data/site";

const categories = Object.entries(categoryLabels);
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.slice(0, 3);
const base = import.meta.env.BASE_URL;
const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Moritz Barz",
  description: "Poster, Merchandise, Eventdesign und funktionale 3D-Prints fuer Metal, Festivals und Tauchsport.",
  url: Astro.site?.toString(),
  areaServed: "DE",
  serviceType: ["Poster Design", "Merchandise Design", "Event Design", "3D-Printing"],
};
---

<BaseLayout structuredData={homeStructuredData}>
  <Header />

  <main>
    <header class="hero">
      <Image src={heroSource} alt="" width={1800} height={1013} class="hero-media" loading="eager" decoding="async" aria-hidden="true" />
      <div class="container hero-inner">
        <p class="eyebrow">Metal Design / Festival Merch / Functional 3D-Print</p>
        <h1>Heavy Design. Deep Impact.</h1>
        <p class="hero-subline">Ich entwickle Poster, Merch, Eventgrafik und funktionale 3D-Prints fuer Menschen, die laute Gestaltung und praezise Loesungen brauchen.</p>
        <div class="hero-actions">
          <a class="btn hero-cta" href="#portfolio">Arbeiten ansehen</a>
        <a class="btn btn-secondary" href="#contact">Projekt anfragen</a>
        </div>
      </div>
    </header>

    <section class="proof-strip" aria-label="Kurzprofil">
      <div class="container proof-grid">
        <p><strong>Wacken Open Air</strong><span>Merchandise und Objektgrafik fuer Festival-Kontexte.</span></p>
        <p><strong>DLRG Einsatzmaterial</strong><span>3D-Druckteile, die nicht nur gut aussehen, sondern funktionieren muessen.</span></p>
        <p><strong>Metal im Dorf</strong><span>Poster und Eventmotive mit Szene-Energie und klarer Lesbarkeit.</span></p>
      </div>
    </section>

    <section class="partners-ribbon" aria-labelledby="partner-title">
      <div class="container">
        <h2 id="partner-title" class="partner-title">Trusted by</h2>
        <div class="logo-grid">
          {partners.map((partner) => <img src={`${base}${partner.logo}`} alt={partner.name} loading="lazy" decoding="async" />)}
        </div>
      </div>
    </section>

    <section id="portfolio" class="section">
      <div class="container">
        <div class="section-heading section-heading-wide">
          <div>
            <p class="eyebrow">Selected Work</p>
            <h2 class="section-title">Arbeiten, die Szene und Funktion verbinden.</h2>
          </div>
          <p>Von Festivalshirts bis Tauchausruestung: Die Projekte sind nicht nur visuelle Oberflaeche, sondern Antworten auf konkrete Einsaetze.</p>
        </div>
        <div class="filter-controls" aria-label="Portfolio filtern">
          {
            categories.map(([key, label], index) => (
              <button class:list={["filter-btn", { active: index === 0 }]} type="button" data-filter={key} aria-pressed={index === 0 ? "true" : "false"}>
                {label}
              </button>
            ))
          }
        </div>
        <div class="gallery-grid" id="project-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
        <p class="empty-state" id="empty-state" hidden>Keine Arbeiten in dieser Kategorie gefunden.</p>
      </div>
    </section>

    <section class="section spotlight-section">
      <div class="container">
        <div class="section-heading section-heading-wide">
          <div>
            <p class="eyebrow">Dramaturgie</p>
            <h2 class="section-title">Drei Richtungen, ein Kern.</h2>
          </div>
          <p>Die Arbeiten bewegen sich zwischen lauter Festivalidentitaet, tragbarem Merch und technischen Teilen, die im echten Einsatz bestehen muessen.</p>
        </div>
        <div class="spotlight-grid">
          {featuredProjects.map((project) => (
            <a class="spotlight-card" href={`${base}work/${project.id.replace(/\.md$/, "")}/`}>
              <Image src={project.data.heroImage} alt={project.data.title} widths={[520, 900]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" decoding="async" />
              <span>{categoryLabels[project.data.category]}</span>
              <h3>{project.data.shortTitle}</h3>
              <p>{project.data.impact}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="section bg-alt">
      <div class="container split-section">
        <div>
          <p class="eyebrow">Persoenlichkeit</p>
          <h2 class="section-title">Ich denke Gestaltung wie Ausruestung.</h2>
        </div>
        <div class="copy-block">
          <p>
            Ich komme aus der Metalszene und aus dem Tauchen. Beides ist direkter, ehrlicher und anspruchsvoller, als es von aussen wirkt. Ein Festivalmotiv muss in Sekunden zünden. Ein 3D-gedrucktes Teil muss passen, halten und im Alltag Sinn ergeben.
          </p>
          <p>
            Genau da arbeite ich gern: an der Stelle, an der Gestaltung nicht dekoriert, sondern etwas klaert. Fuer Bands, Festivals, Vereine, Tauchbasen und Marken, die eine visuelle Sprache brauchen, die nicht weichgespült klingt.
          </p>
          <div class="principle-grid">
            <span>laut, wenn es laut sein muss</span>
            <span>praezise, wenn Funktion zaehlt</span>
            <span>nah an der Szene statt generisch</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Ablauf</p>
          <h2 class="section-title">Vom ersten Riff bis zur fertigen Datei.</h2>
        </div>
        <ol class="process-list">
          <li><strong>Kontext klaeren</strong><span>Worum geht es, wo wird es genutzt, wer muss es verstehen?</span></li>
          <li><strong>Motiv entwickeln</strong><span>Look, Hierarchie und Funktion werden zusammen gedacht.</span></li>
          <li><strong>Finalisieren</strong><span>Printdaten, Social Assets oder 3D-Druckdateien gehen sauber raus.</span></li>
        </ol>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Projekt im Kopf?</h2>
          <p class="contact-copy">Schick mir kurz, worum es geht: Event, Merch, Poster, 3D-Print oder etwas dazwischen. Ich antworte mit Rueckfragen, einer Einschaetzung und dem naechsten sinnvollen Schritt.</p>
          <ul class="contact-notes">
            <li>Ideal fuer Festivals, Bands, Vereine und Tauchprojekte</li>
            <li>Von Einzelmotiv bis kleiner visueller Serie</li>
            <li>Direkt, klar und ohne Agenturtheater</li>
          </ul>
        </div>
        <form class="contact-form" name="contact" method="POST" action={formspreeEndpoint}>
          <label for="name">Name / Brand</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <label for="message">Projektanfrage</label>
          <textarea id="message" name="message" rows="5" required></textarea>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden-field" />
          <input type="hidden" name="_subject" value="Neue Projektanfrage ueber moritzbarz.de" />
          <button type="submit" class="btn">Send Message</button>
        </form>
      </div>
    </section>
  </main>

  <script>
    const hamburger = document.querySelector(".hamburger");
    const navLinks = document.querySelector(".nav-links");
    const filterButtons = document.querySelectorAll(".filter-btn");
    const projectCards = document.querySelectorAll(".project-card");
    const emptyState = document.querySelector("#empty-state");

    hamburger?.addEventListener("click", () => {
      const isOpen = hamburger.classList.toggle("active");
      navLinks?.classList.toggle("active", isOpen);
      hamburger.setAttribute("aria-expanded", String(isOpen));
      hamburger.setAttribute("aria-label", isOpen ? "Menue schliessen" : "Menue oeffnen");
    });

    navLinks?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        hamburger?.classList.remove("active");
        navLinks.classList.remove("active");
        hamburger?.setAttribute("aria-expanded", "false");
        hamburger?.setAttribute("aria-label", "Menue oeffnen");
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        let visibleCount = 0;

        filterButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });

        projectCards.forEach((card) => {
          const isVisible = filter === "all" || card.getAttribute("data-category") === filter;
          card.toggleAttribute("hidden", !isVisible);
          if (isVisible) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount > 0;
      });
    });
  </script>
</BaseLayout>
