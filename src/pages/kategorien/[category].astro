---
import CategoryView from "../../views/CategoryView.astro";
import { getActiveCategories, type CategoryInfo } from "../../lib/content";

export async function getStaticPaths() {
  const categories = await getActiveCategories();
  return categories.map((category) => ({ params: { category: category.value }, props: { category } }));
}

type Props = { category: CategoryInfo };
---

<CategoryView lang="de" category={Astro.props.category} />
