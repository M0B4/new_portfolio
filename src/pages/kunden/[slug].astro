---
import ClientView from "../../views/ClientView.astro";
import type { ClientGroup } from "../../lib/clients";
import { getSiteContent } from "../../lib/content";

export async function getStaticPaths() {
  const { clients } = await getSiteContent();
  return clients.map((group) => ({ params: { slug: group.profile.slug }, props: { group } }));
}

type Props = { group: ClientGroup };
---

<ClientView lang="de" group={Astro.props.group} />
