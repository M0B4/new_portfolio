---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { categoryLabels } from "../../data/site";
import { getClientGroups } from "../../lib/clients";

export async function getStaticPaths() {
  const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  const clientGroups = getClientGroups(projects, true);

  return clientGroups.map((group) => ({
    params: { slug: group.profile.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const base = import.meta.env.BASE_URL;
const cover = group.projects[0];
const categories = [...new Set(group.projects.map((project) => categoryLabels[project.data.category]))];
const seoTitle = `${group.profile.label} | Arbeiten von Moritz Barz`;
const seoDescription = group.profile.summary;
const clientStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${group.profile.label} Arbeiten`,
  description: seoDescription,
  url: new URL(`${base}kunden/${group.profile.slug}/`, Astro.site ?? Astro.url.origin),
};
---

<BaseLayout title={seoTitle} description={seoDescription} image={group.profile.logo ?? cover?.data.heroImage.src ?? "images/header.jpg"} structuredData={clientStructuredData}>
  <Header simple />

  <main>
    <header class="client-hero">
      <img class="client-hero-logo-bg" src={`${base}${group.profile.logo}`} alt="" loading="eager" decoding="async" aria-hidden="true" />
      <div class="container client-hero-inner">
        <div class="client-hero-copy">
          <p class="eyebrow">{categories.length > 0 ? categories.join(" / ") : "Portfolio"}</p>
          <h1>{group.profile.label}</h1>
          <p>{group.profile.intro}</p>
        </div>
      </div>
    </header>

    <section class="section client-work-section">
      <div class="container">
        {
          group.projects.length > 0 ? (
            <div class="client-work-grid">
              {group.projects.map((project) => <ProjectCard project={project} />)}
            </div>
          ) : (
            <p class="client-empty-note" data-i18n-de="Arbeiten für diesen Kontext werden noch kuratiert." data-i18n-en="Work for this context is still being curated.">Arbeiten für diesen Kontext werden noch kuratiert.</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
