---
import { SANITY_STUDIO_URL } from "../data/site";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${SANITY_STUDIO_URL}`} />
    <link rel="canonical" href={SANITY_STUDIO_URL} />
    <title>Sanity Studio – Moritz Barz</title>
    <style>
      body {
        margin: 0;
        display: grid;
        min-height: 100vh;
        place-items: center;
        background: #0b0b0b;
        color: #ece6da;
        font: 16px/1.5 ui-monospace, Consolas, monospace;
      }
      a {
        color: #e1262f;
      }
    </style>
  </head>
  <body>
    <p>Weiter zum <a href={SANITY_STUDIO_URL}>Sanity Studio</a> …</p>
  </body>
</html>
