---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientLogo from "../components/ClientLogo.astro";
import Header from "../components/Header.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import TourNav from "../components/TourNav.astro";
import { OWNER_NAME } from "../data/site";
import type { ClientGroup } from "../lib/clients";
import { getSiteContent, getTour, yearSpan } from "../lib/content";
import { getAbsoluteImageUrl } from "../lib/images";
import { clientPath, localizePath, pick, t, type Lang } from "../lib/i18n";
import { assetUrl } from "../lib/url";

type Props = {
  lang: Lang;
  group: ClientGroup;
};

const { lang, group } = Astro.props;
const ui = t(lang);
const { categories } = await getSiteContent();
const { stops } = await getTour();
const origin = Astro.site ?? Astro.url.origin;
const { profile, projects } = group;
const alternates = { de: clientPath("de", profile.slug), en: clientPath("en", profile.slug) };
const categoryLabels = categories
  .filter((category) => projects.some((project) => project.category === category.value))
  .map((category) => category.label[lang]);
const summary = pick(lang, profile.summary, profile.summaryEn);
const intro = pick(lang, profile.intro, profile.introEn);
const seoTitle = lang === "de" ? `${profile.label} | Arbeiten von ${OWNER_NAME}` : `${profile.label} | Work by ${OWNER_NAME}`;
const ogImage = projects[0] ? await getAbsoluteImageUrl(projects[0].previewImage, origin) : undefined;
const projectImages = await Promise.all(projects.map((project) => getAbsoluteImageUrl(project.previewImage, origin, 800)));

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: ui.workFor(profile.label),
    description: summary,
    inLanguage: lang,
    url: new URL(alternates[lang], origin).toString(),
    mainEntity: {
      "@type": "ItemList",
      itemListElement: projects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: pick(lang, project.title, project.titleEn),
        image: projectImages[index],
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: ui.home, item: new URL(localizePath(lang), origin).toString() },
      { "@type": "ListItem", position: 2, name: profile.label, item: new URL(alternates[lang], origin).toString() },
    ],
  },
];

const years = yearSpan(projects);
const stats = [projects.length > 0 ? ui.projectCount(projects.length) : "", years, categoryLabels.join(" / ")].filter(Boolean);
---

<BaseLayout
  lang={lang}
  title={seoTitle}
  description={summary}
  image={ogImage ?? (profile.logo ? assetUrl(profile.logo) : undefined)}
  alternates={alternates}
  structuredData={structuredData}
>
  <Header lang={lang} alternates={alternates} />

  <main id="main">
    <header class="client-hero">
      <div class="container client-hero-inner">
        <nav class="breadcrumb" aria-label={ui.breadcrumb}>
          <ol>
            <li><a href={`${localizePath(lang)}#portfolio`}>{ui.home}</a></li>
            <li><span aria-current="page">{profile.label}</span></li>
          </ol>
        </nav>
        <p class="section-label">
          <span class="section-number">{ui.tourStop}</span>
          {stats.length > 0 && <span> / {stats.join(" · ")}</span>}
        </p>
        <h1 class="client-name misreg">{profile.label}</h1>
        <div class="client-hero-copy">
          <ClientLogo class="client-hero-logo" profile={profile} height={56} loading="eager" />
          <p>{intro}</p>
        </div>
      </div>
    </header>

    <section class="section client-work-section" aria-label={ui.workFor(profile.label)}>
      <div class="container">
        {
          projects.length > 0 ? (
            <ProjectGrid projects={projects} categories={categories} lang={lang} filterable priorityFirst />
          ) : (
            <p class="client-empty-note">{ui.emptyClient}</p>
          )
        }
      </div>
    </section>

    <TourNav stops={stops} currentSlug={profile.slug} lang={lang} />
  </main>
</BaseLayout>
