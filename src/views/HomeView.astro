---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientWall from "../components/ClientWall.astro";
import Header from "../components/Header.astro";
import Lightbox from "../components/Lightbox.astro";
import LogoRow from "../components/LogoRow.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import portrait from "../assets/header.jpg";
import { OWNER_NAME, SITE_NAME } from "../data/site";
import { getSiteContent, getTour } from "../lib/content";
import { getResponsiveImage } from "../lib/images";
import { localizePath, pick, t, workPath, type Lang } from "../lib/i18n";
import { assetUrl } from "../lib/url";
import type { PortfolioProject } from "../lib/projects";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const ui = t(lang);
const { projects, settings, socialLinks, categories } = await getSiteContent();
const { stops } = await getTour();
// Logos are advertising: show every client with a logo, also those whose work is still being curated.
const { stops: logoStops } = await getTour({ includeEmpty: true });
const origin = Astro.site ?? Astro.url.origin;
const alternates = { de: localizePath("de"), en: localizePath("en") };

// Hero work: first "Hervorheben" project, otherwise the top project of the first client.
const heroProject = projects.find((project) => project.featured) ?? stops[0]?.projects[0];
const heroImage = heroProject
  ? await getResponsiveImage(heroProject.previewImage, [480, 720, 960, 1280], { quality: 78 })
  : undefined;
const heroClient = heroProject ? stops.find((stop) => stop.projects.includes(heroProject))?.profile.label : undefined;

// Three highlights: further "Hervorheben" projects, then one project from each of the next clients.
const highlights: PortfolioProject[] = projects.filter((project) => project.featured && project !== heroProject);
for (const stop of stops) {
  if (highlights.length >= 3) break;
  const candidate = stop.projects.find((project) => project !== heroProject && !highlights.includes(project));
  if (candidate && !highlights.some((project) => stop.projects.includes(project))) highlights.push(candidate);
}
const selected = highlights.slice(0, 3);

// Two more flyers pasted behind the hero work, like posters stacked on a pillar (posters first).
const stackCandidates = projects.filter((project) => project !== heroProject && !selected.includes(project));
const stackProjects = [
  ...stackCandidates.filter((project) => project.category === "poster"),
  ...stackCandidates.filter((project) => project.category !== "poster"),
].slice(0, 2);
const stackImages = await Promise.all(
  stackProjects.map((project) => getResponsiveImage(project.previewImage, [320, 480], { quality: 70 })),
);

const heroKicker = pick(lang, settings.heroKickerDe || "Grafikdesign · Poster · Merch · 3D-Druck", settings.heroKickerEn || "Graphic design · Posters · Merch · 3D printing");
const heroTitle = pick(
  lang,
  settings.heroTitleDe || "Poster, Merch und Artwork für Festivals, Bands und die Metal-Szene.",
  settings.heroTitleEn || "Posters, merch and artwork for festivals, bands and the metal scene.",
);
const heroText = pick(
  lang,
  settings.heroTextDe ||
    "Ich bin Moritz, Grafikdesigner aus der Pfalz. Ich gestalte Plakate, Shirts und Bändchen, die auf dem Festivalgelände genauso funktionieren wie im Feed, und konstruiere funktionale Teile für den 3D-Druck.",
  settings.heroTextEn ||
    "I'm Moritz, a graphic designer from southwest Germany. I design posters, shirts and wristbands that work on the festival grounds as well as in your feed, and I build functional parts for 3D printing.",
);
const aboutText = (lang === "en" ? settings.aboutTextEn : settings.aboutTextDe) || ui.profileText;
const aboutParagraphs = aboutText.split(/\n\s*\n/).filter(Boolean);

const homeUrl = new URL(localizePath(lang), origin).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: homeUrl,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: OWNER_NAME,
    url: homeUrl,
    image: new URL(assetUrl("images/header.jpg"), origin).toString(),
    jobTitle: lang === "de" ? "Grafikdesigner" : "Graphic designer",
    knowsAbout: ["Poster Design", "Merchandise Design", "Event Design", "3D Printing"],
    ...(socialLinks.length > 0 ? { sameAs: socialLinks.map((link) => link.url) } : {}),
  },
];
---

<BaseLayout lang={lang} alternates={alternates} structuredData={structuredData}>
  <Header lang={lang} alternates={alternates} />

  <main id="main" class="home">
    <!-- Hero: claim + one piece of work, client logos underneath -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="section-label">{heroKicker}</p>
          <h1 id="hero-title" class="hero-title">{heroTitle}</h1>
          <p class="hero-text">{heroText}</p>
          <div class="hero-actions">
            <a class="btn" href="#contact">{ui.heroCtaPrimary}</a>
            <a class="btn btn-outline" href={workPath(lang)}>{ui.heroCtaWork}</a>
          </div>
        </div>
        {
          heroImage && heroProject && (
            <figure class="hero-figure">
              {stackImages.map((image, index) => (
                <img
                  class:list={["hero-stack", `hero-stack-${index + 1}`, { "is-cutout": image.transparent }]}
                  src={image.src}
                  srcset={image.srcset}
                  sizes="(min-width: 820px) 22vw, 40vw"
                  width={image.width}
                  height={image.height}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
              ))}
              <span class:list={["hero-frame", { taped: !heroImage.transparent }]}>
                <img
                  class:list={["hero-image", { "is-cutout": heroImage.transparent }]}
                  src={heroImage.src}
                  srcset={heroImage.srcset}
                  sizes="(min-width: 820px) 46vw, calc(100vw - 2.5rem)"
                  width={heroImage.width}
                  height={heroImage.height}
                  alt={heroProject.alt}
                  fetchpriority="high"
                  decoding="async"
                />
              </span>
              <figcaption class="spec">
                {pick(lang, heroProject.title, heroProject.titleEn)}
                {heroClient && <> / {heroClient}</>} / {heroProject.year}
              </figcaption>
            </figure>
          )
        }
      </div>
      <div class="container">
        <LogoRow stops={logoStops} lang={lang} />
      </div>
    </section>

    <!-- 1 · Selected work -->
    <section id="work" class="section selected-section" aria-labelledby="selected-title">
      <div class="container">
        <SectionHeading id="selected-title" number="1" kicker={ui.selectedKicker} title={ui.selectedTitle} />
        <ProjectGrid projects={selected} categories={categories} lang={lang} layout="trio" lightbox={false} eagerCount={0} />
        <p class="section-cta">
          <a class="btn btn-outline" href={workPath(lang)}>{ui.discoverAll} →</a>
        </p>
      </div>
    </section>

    <!-- 2 · Clients: logo wall on a black band -->
    <section id="clients" class="section band clients-section" aria-labelledby="clients-title">
      <div class="container">
        <SectionHeading id="clients-title" number="2" kicker={ui.clientsKicker} title={ui.clientsTitle} text={ui.clientsText} />
        <ClientWall stops={logoStops} lang={lang} />
      </div>
    </section>

    <!-- 3 · Profile -->
    <section id="about" class="section profile-section" aria-labelledby="about-title">
      <div class="container profile-layout">
        <figure class="profile-portrait taped reveal">
          <span class="halftone">
            <Image src={portrait} alt={ui.portraitAlt} widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 100vw" loading="lazy" />
          </span>
        </figure>
        <div class="profile-copy reveal">
          <span class="section-numeral" aria-hidden="true">3</span>
          <p class="section-label">{ui.profileKicker}</p>
          <h2 id="about-title">{ui.profileTitle}</h2>
          {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>
  </main>
  <Lightbox lang={lang} />
</BaseLayout>
