---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryIndex from "../components/CategoryIndex.astro";
import Header from "../components/Header.astro";
import Lightbox from "../components/Lightbox.astro";
import Marquee from "../components/Marquee.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Setlist from "../components/Setlist.astro";
import TourList from "../components/TourList.astro";
import portrait from "../assets/header.jpg";
import { OWNER_NAME, SITE_NAME } from "../data/site";
import { getActiveCategories, getSiteContent, getTour } from "../lib/content";
import { getResponsiveImage } from "../lib/images";
import { categoryPath, localizePath, pick, t, type Lang } from "../lib/i18n";
import { assetUrl } from "../lib/url";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const ui = t(lang);
const { projects, settings, socialLinks, categories: allCategories } = await getSiteContent();
const { stops, years } = await getTour();
const categories = await getActiveCategories();
const origin = Astro.site ?? Astro.url.origin;
const alternates = { de: localizePath("de"), en: localizePath("en") };

// Front print: first "Hervorheben" project, otherwise the top project of the first tour stop (Wacken).
const frontProject = projects.find((project) => project.featured) ?? stops[0]?.projects[0];
const frontImage = frontProject
  ? await getResponsiveImage(frontProject.previewImage, [480, 720, 960, 1280], { quality: 75 })
  : undefined;

// Merch table: featured first, then round-robin across clients so no single series dominates.
const pickSelectedWork = (limit: number) => {
  const picked = projects.filter((project) => project.featured && project !== frontProject);
  const queues = stops.map((stop) => stop.projects.filter((project) => project !== frontProject));
  while (picked.length < limit && queues.some((queue) => queue.length > 0)) {
    for (const queue of queues) {
      const next = queue.shift();
      if (next && !picked.includes(next) && picked.length < limit) picked.push(next);
    }
  }
  return picked;
};
const selectedWork = pickSelectedWork(8);

const heroKicker = pick(lang, settings.heroKickerDe || "Moritz Barz / Portfolio", settings.heroKickerEn);
const heroTitle = pick(
  lang,
  settings.heroTitleDe || "Grafik, Merch und Objekte für laute Kontexte.",
  settings.heroTitleEn || "Graphics, merch and objects for loud contexts.",
);
const heroText = pick(
  lang,
  settings.heroTextDe ||
    "Visuelle Arbeiten für Festivals, Events, Szene-Marken und funktionale Anwendungen: rau im Charakter, sauber in der Umsetzung.",
  settings.heroTextEn ||
    "Visual work for festivals, events, scene brands and functional use: rough in character, precise in execution.",
);
const aboutText = (lang === "en" ? settings.aboutTextEn : settings.aboutTextDe) || ui.profileText;
const aboutParagraphs = aboutText.split(/\n\s*\n/).filter(Boolean);

const homeUrl = new URL(localizePath(lang), origin).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: homeUrl,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: OWNER_NAME,
    url: homeUrl,
    image: new URL(assetUrl("images/header.jpg"), origin).toString(),
    jobTitle: lang === "de" ? "Grafikdesigner" : "Graphic designer",
    knowsAbout: ["Poster Design", "Merchandise Design", "Event Design", "3D Printing"],
    ...(socialLinks.length > 0 ? { sameAs: socialLinks.map((link) => link.url) } : {}),
  },
];
---

<BaseLayout lang={lang} alternates={alternates} structuredData={structuredData}>
  <Header lang={lang} alternates={alternates} />

  <main id="main" class="home">
    <!-- Front print: name + one piece of work -->
    <section class="front-print" aria-labelledby="hero-title">
      <div class="container front-grid">
        <div class="front-copy">
          <p class="section-label">
            <span class="section-number">{heroKicker}</span>
            {years && <span> / {years}</span>}
          </p>
          <p class="front-claim">{heroTitle}</p>
          <p class="front-text">{heroText}</p>
          <div class="hero-actions">
            <a class="btn" href="#contact">{ui.heroCtaPrimary}</a>
            <a class="btn btn-outline" href="#work">{ui.heroCtaSecondary}</a>
          </div>
        </div>
        {
          frontImage && frontProject && (
            <figure class="front-figure print-frame">
              <img
                class="halftone halftone-hero"
                src={frontImage.src}
                srcset={frontImage.srcset}
                sizes="(min-width: 820px) 42vw, 90vw"
                width={frontImage.width}
                height={frontImage.height}
                alt={frontProject.alt}
                fetchpriority="high"
                decoding="async"
              />
              <figcaption class="spec">
                {frontProject.clientProfile?.label ?? frontProject.client} / {frontProject.year}
              </figcaption>
            </figure>
          )
        }
      </div>
      <h1 id="hero-title" class="container front-name">
        <span class="misreg misreg-hero">Moritz Barz</span>
        <span class="sr-only"> – {heroTitle}</span>
      </h1>
    </section>

    <Marquee items={categories.map((category) => category.label[lang])} />

    <!-- Merch table: selected work -->
    <section id="work" class="section work-section" aria-labelledby="work-title">
      <div class="container">
        <SectionHeading id="work-title" number="01" kicker={ui.merchKicker} title={ui.workTitle} />
        <ProjectGrid projects={selectedWork} categories={allCategories} lang={lang} lightbox={false} eagerCount={0} />
      </div>
    </section>

    <!-- Back print: clients as tour dates -->
    <section id="portfolio" class="section tour-section" aria-labelledby="tour-title">
      <div class="container">
        <p class="section-label tour-kicker"><span class="section-number">02</span> {ui.tourKicker}</p>
        <h2 id="tour-title" class="tour-title misreg">
          <span class="tour-star" aria-hidden="true">✶</span>
          {ui.tourTitle("")}
          <span class="tour-star" aria-hidden="true">✶</span>
          {years && <span class="tour-title-years">{years}</span>}
        </h2>
        <p class="tour-intro">{ui.tourIntro}</p>
        <TourList stops={stops} lang={lang} />
      </div>
    </section>

    <!-- Fields of work -->
    <section class="section fields-section" aria-labelledby="fields-title">
      <div class="container">
        <SectionHeading id="fields-title" number="03" kicker={ui.fieldsKicker} title={ui.fieldsTitle} />
        <CategoryIndex categories={categories} projects={projects} lang={lang} />
      </div>
    </section>

    <!-- Setlist: process -->
    <section class="section setlist-section" aria-labelledby="setlist-title">
      <div class="container">
        <SectionHeading id="setlist-title" number="04" kicker={ui.setlistKicker} title={ui.setlistTitle} />
        <Setlist lang={lang} />
      </div>
    </section>

    <!-- Backstage: profile -->
    <section id="about" class="section backstage-section" aria-labelledby="about-title">
      <div class="container backstage-layout">
        <figure class="backstage-portrait print-frame">
          <Image
            class="halftone halftone-reveal"
            src={portrait}
            alt={ui.portraitAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 820px) 45vw, 100vw"
            loading="lazy"
          />
        </figure>
        <div class="backstage-copy">
          <p class="section-label"><span class="section-number">05</span> {ui.backstageKicker}</p>
          <h2 id="about-title">{ui.profileTitle}</h2>
          {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          <h3 class="spec services-title">{ui.servicesTitle}</h3>
          <ul class="services-list">
            {
              categories.map((category) => (
                <li>
                  <a href={categoryPath(lang, category.value)}>{category.label[lang]}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Lightbox lang={lang} />
</BaseLayout>
